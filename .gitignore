# Keep only the frontend and its repository documentation at the root.
/*
!/frontend/
!/.gitignore
!/README.md

# frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts

# env
.env
.env.local
.env.*.local

# debug / OS / editor
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
